/* transkript — Textual CSS */

Screen {
    layout: vertical;
}

#main-content {
    height: 1fr;
    align: center middle;
}

#record-btn {
    width: 40;
    height: 5;
    margin: 1 0;
    text-style: bold;
}

#status {
    width: 100%;
    text-align: center;
    padding: 1 0;
    text-style: bold;
}

#duration-display {
    width: 100%;
    text-align: center;
    padding: 0 0;
    color: $text-muted;
}

#file-info {
    width: 100%;
    text-align: center;
    padding: 1 0;
    color: $accent;
}

#file-links {
    width: 100%;
    height: auto;
    align: center middle;
    padding: 0 0;
}

#open-file-btn {
    margin: 0 1;
    min-width: 16;
}

#open-folder-btn {
    margin: 0 1;
    min-width: 16;
}

#device-bar {
    width: 100%;
    height: auto;
    padding: 1 2;
    dock: bottom;
    align: center middle;
    background: $surface-darken-1;
    border-top: tall $primary;
}

#mic-label {
    width: auto;
    padding: 0 1 0 0;
    color: $text-muted;
}

#output-label {
    width: auto;
    padding: 0 1 0 0;
    color: $text-muted;
}

#mic-select {
    width: 1fr;
    max-width: 30;
}

#output-select {
    width: 1fr;
    max-width: 30;
}
