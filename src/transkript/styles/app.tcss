/* transkript — Textual CSS */

/* === Theme Overrides === */
Screen {
    background: #1a1a1a;
    color: #e0e0e0;
}

Header {
    background: #2d2d2d;
    color: #ffffff;
    dock: top;
}

Footer {
    background: #2d2d2d;
    color: #888888;
    dock: bottom;
}

/* === Main Content === */
#main-content {
    height: 1fr;
    align: center middle;
    background: #1a1a1a;
}

/* === Record Button === */
#record-btn {
    width: 42;
    height: 5;
    margin: 1 0;
    text-style: bold;
    content-align: center middle;
}

/* === Status === */
#status {
    width: 100%;
    text-align: center;
    padding: 1 0;
    text-style: bold;
    color: #ffffff;
}

#duration-display {
    width: 100%;
    text-align: center;
    padding: 0 0;
    color: #757575;
}

#file-info {
    width: 100%;
    text-align: center;
    padding: 1 0;
    color: #66bb6a;
    text-style: bold;
}

/* === File Action Buttons === */
#file-links {
    width: 100%;
    height: auto;
    align: center middle;
    padding: 0 0;
}

#open-file-btn {
    margin: 0 1;
    min-width: 18;
}

#open-folder-btn {
    margin: 0 1;
    min-width: 18;
}

/* === Device Bar === */
#device-bar {
    width: 100%;
    height: auto;
    padding: 1 2;
    dock: bottom;
    align: center middle;
    background: #252525;
    border-top: tall #388e3c;
}

#mic-label {
    width: auto;
    padding: 0 1 0 0;
    color: #9e9e9e;
    text-style: bold;
}

#output-label {
    width: auto;
    padding: 0 1 0 0;
    color: #9e9e9e;
    text-style: bold;
}

#lang-label {
    width: auto;
    padding: 0 1 0 0;
    color: #9e9e9e;
    text-style: bold;
}

#model-label {
    width: auto;
    padding: 0 1 0 0;
    color: #9e9e9e;
    text-style: bold;
}

#mic-select {
    width: 1fr;
    max-width: 25;
}

#output-select {
    width: 1fr;
    max-width: 25;
}

#lang-select {
    width: 1fr;
    max-width: 20;
}

#model-select {
    width: 1fr;
    max-width: 22;
}
