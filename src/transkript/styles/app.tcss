/* transkript — Textual CSS */

/* === Theme Overrides === */
Screen {
    background: #1a1a1a;
    color: #e0e0e0;
}

Header {
    background: #2d2d2d;
    color: #ffffff;
    dock: top;
}

Footer {
    background: #2d2d2d;
    color: #888888;
    dock: bottom;
}

/* === Root Layout === */
#root {
    height: 1fr;
}

/* === Main Content === */
#main-content {
    width: 1fr;
    height: 1fr;
    align: center middle;
    background: #1a1a1a;
}

/* === Record Button === */
#record-btn {
    width: 42;
    height: 5;
    margin: 1 0;
    text-style: bold;
    content-align: center middle;
}

/* === Status === */
#status {
    width: 100%;
    text-align: center;
    padding: 1 0;
    text-style: bold;
    color: #ffffff;
}

#duration-display {
    width: 100%;
    text-align: center;
    padding: 0 0;
    color: #757575;
}

#file-info {
    width: 100%;
    text-align: center;
    padding: 1 0;
    color: #66bb6a;
    text-style: bold;
}

/* === File Action Buttons === */
#file-links {
    width: 100%;
    height: auto;
    align: center middle;
    padding: 0 0;
}

#open-file-btn {
    margin: 0 1;
    min-width: 18;
}

#open-folder-btn {
    margin: 0 1;
    min-width: 18;
}

/* === Settings Panel (RHS) === */
#settings-panel {
    width: 30;
    height: 1fr;
    padding: 1 2;
    background: #252525;
    border-left: tall #388e3c;
}

#mic-label,
#output-label,
#lang-label,
#model-label {
    width: 100%;
    padding: 1 0 0 0;
    color: #9e9e9e;
    text-style: bold;
}

#mic-select,
#output-select,
#lang-select,
#model-select {
    width: 100%;
    margin-bottom: 1;
}

/* === Low-spec Toggle === */
#low-spec-row {
    width: 100%;
    height: auto;
    align: left middle;
    padding: 1 0 0 0;
    margin-top: 1;
    border-top: solid #444;
}

#low-spec-switch {
    min-width: 6;
    margin-right: 1;
}

#low-spec-label {
    width: auto;
    color: #ff9800;
    text-style: bold;
}
